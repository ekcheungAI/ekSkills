{
  "_comment": "Merge into ~/.claude/settings.json by hand (editing settings is a named authorization). SessionStart shows the brief; SessionEnd reports rooms left behind; PreToolUse blocks edits inside a guarded library. Nothing here deletes anything.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/supergit/scripts/supergit.py brief --no-fetch 2>/dev/null | head -40",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/supergit/scripts/supergit.py finish --dry-run 2>/dev/null | tail -8",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/supergit/hooks/guard_library_edit.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
